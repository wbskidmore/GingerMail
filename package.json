{
  "name": "gingermail",
  "version": "1.0.8",
  "private": true,
  "description": "GingerMail - cross-platform desktop email + calendar + tasks, ADHD-friendly",
  "author": "William Skidmore",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm exec tsc -b packages/ui-kit/tsconfig.json && concurrently -k -n renderer,main -c blue,green \"pnpm --filter @gingermail/renderer dev\" \"pnpm --filter @gingermail/main dev\"",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @gingermail/renderer build && pnpm --filter @gingermail/main build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "pnpm -r test --if-present",
    "test:e2e": "playwright test",
    "dist": "pnpm prepackage && pnpm build && electron-builder --mac --win",
    "dist:mac": "pnpm prepackage && pnpm build && electron-builder --mac",
    "dist:win": "pnpm prepackage && pnpm build && electron-builder --win",
    "dist:linux": "pnpm prepackage && pnpm build && electron-builder --linux",
    "dist:no-ollama": "pnpm build && electron-builder --mac --win",
    "dist:mac:no-ollama": "pnpm build && electron-builder --mac",
    "dist:win:no-ollama": "pnpm build && electron-builder --win",
    "dist:linux:no-ollama": "pnpm build && electron-builder --linux",
    "dist:all:no-ollama": "pnpm build && electron-builder --mac --win --linux",
    "dist:mac:dev": "CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build && electron-builder --mac --config.mac.notarize=false",
    "dist:win:dev": "pnpm build && electron-builder --win",
    "dist:linux:dev": "pnpm build && electron-builder --linux",
    "prepackage": "node scripts/fetch-ollama.mjs --all",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3 --module-dir packages/storage",
    "build:icons": "node scripts/build-icons.mjs",
    "fetch:ollama": "node scripts/fetch-ollama.mjs",
    "postinstall": "electron-builder install-app-deps",
    "sbom": "cdxgen -t pnpm -o sbom.cdx.json",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.3",
    "@gingermail/ai": "workspace:*",
    "@gingermail/core": "workspace:*",
    "@gingermail/main": "workspace:*",
    "@gingermail/providers": "workspace:*",
    "@gingermail/storage": "workspace:*",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dompurify": "^3.4.12",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "googleapis": "^173.0.0",
    "ical.js": "^2.2.1",
    "imapflow": "^1.6.5",
    "jsdom": "^25.0.1",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.3",
    "tsdav": "^2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cyclonedx/cdxgen": "^12.8.2",
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "7",
    "vitest": "^4.1.10"
  }
}
